# Servidor Professor IA
PORT=3001
HOST=127.0.0.1
# Orígenes permitidos separados por coma para web, Android y desarrollo.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
# Directorio persistente. Electron lo configura automáticamente en userData.
PROFESOR_IA_DATA_DIR=
# Límite de solicitudes por IP y ventana de 15 minutos.
RATE_LIMIT_MAX=120

# Motor de texto (opcional). Sin clave conserva el gateway legacy.
POLLINATIONS_API_URL=
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=openai
AI_TIMEOUT_MS=90000

# Transcripción de audio opcional para el fallback MediaRecorder.
# Se configura solo en el servidor; nunca se expone al frontend.
TRANSCRIPTION_API_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=openai/whisper-large-v3
TRANSCRIPTION_TIMEOUT_MS=90000

# Variables que Vite expone al cliente (no contienen secretos).
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://localhost:3001
