# Copia este archivo a ../.env (la raíz del proyecto) o define las variables
# en el entorno de compilación. Vite las carga desde la raíz para que funcionen
# `npm run dev`, web y Android con la misma configuración.
# Déjala vacía para web same-origin o Electron.
# Android emulador: http://10.0.2.2:3001
# Android físico/producción: usa una URL HTTPS, por ejemplo https://api.ejemplo.com
VITE_API_BASE_URL=
# Proxy usado únicamente por Vite en desarrollo.
VITE_API_PROXY_TARGET=http://localhost:3001
