{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "./",
  "name": "Profesor IA - Tu Tutor Universal",
  "short_name": "Profesor IA",
  "description": "Tu profesor de IA personal: dudas, revisión de ejercicios y prácticas de examen para primaria, secundaria, universidad y más.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#04060e",
  "theme_color": "#4f46e5",
  "lang": "es",
  "dir": "ltr",
  "categories": ["education", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
